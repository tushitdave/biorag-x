# Copy to .env and fill in. The .env file is gitignored and must never be committed.
# Every stage except answer generation runs without these: retrieval, ranking, scoring
# and the judge are local. Leave them empty and the system falls back to extractive
# answers.

# Azure OpenAI - chat (answer generation, agentic chunking, optional LLM reranking)
AZURE_GPT_4o_API_KEY=
AZURE_GPT_4o_ENDPOINT=
AZURE_GPT_4o_API_VERSION=
AZURE_DEPLOYMENT_GPT_4o=

# Azure OpenAI - embeddings (only for the legacy ada-002 chunk set; MedCPT is local)
embedding_key=
embedding_endpoint=
embedding_api_version=
embedding_model_name=

# Guards
LLM_ENABLED=true          # master switch; false forces fully offline behaviour
LLM_CALL_BUDGET=12        # live (uncached) chat calls allowed per process
